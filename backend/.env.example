PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/budget_wise
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# AI budget coach (optional — chat works when set)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative: Gemini instead of Groq
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
