PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/budget_wise
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Password reset email (Nodemailer / SMTP)
# Without these, local dev shows a reset link on the page instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=BudgetWise <your@gmail.com>
# Optional: exact URL used in reset emails (recommended in production)
# FRONTEND_URL=https://budgetwise-ivory-one.vercel.app

# AI budget coach (optional — chat works when set)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
